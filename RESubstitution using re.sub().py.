import re
text = 'Call 9876543210 or  9123456780  today'
# 1. Mask phone numbers
re.sub(r'\d{10}', 'XXXXXXXXXX', text)
# 2. Collapse multiple spaces into one
re.sub(r'\s+', ' ', text)
